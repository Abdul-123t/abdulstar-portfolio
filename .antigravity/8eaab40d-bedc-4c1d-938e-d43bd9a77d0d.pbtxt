        lines {
          text: "  while (i < debtors.length && j < creditors.length) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const minAmount = Math.min(debtors[i].amount, creditors[j].amount);"
