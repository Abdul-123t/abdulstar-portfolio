    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ArrowDown, ArrowUpRight, Sparkles } from \'lucide-react\';\nimport { PERSONAL_INFO } from \'../data/portfolioData\';\nimport { NamacoLogo } from \'./NamacoLogo\';\n\ninterface HeroProps {\n  onExploreWork: () => void;\n  onConnect: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({ onExploreWork, onConnect }) => {\n  return (\n    <section id=\"hero\" className=\"relative min-h-[92vh] flex flex-col justify-between pt-28 pb-12 px-6 sm:px-8 lg:px-12 border-b border-neutral-900 bg-editorial-grid\">\n      {/* Background radial glow */}\n      <div className=\"absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-white/[0.015] blur-3xl rounded-full pointer-events-none\" />\n\n      {/* Top Metadata Row */}\n      <div className=\"relative z-10 max-w-7xl w-full mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-8 border-b border-neutral-900/80\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-ping\"></span>\n          <span className=\"font-mono text-xs tracking-widest text-neutral-400 uppercase\">\n            AVAILABLE FOR PRODUCTS &amp; VENTURES\n          </span>\n        </div>\n\n        {/* Brand affiliation badge */}\n        <div className=\"flex items-center gap-3 bg-neutral-900/80 border border-neutral-800 px-3.5 py-1.5 rounded-full\">\n          <span className=\"font-mono text-[11px] text-neutral-400 tracking-wider\">\n            {PERSONAL_INFO.brandAffiliation}\n          </span>\n          <span className=\"w-1 h-1 rounded-full bg-neutral-600\"></span>\n          <NamacoLogo size=\"sm\" showSubtitle={false} variant=\"light\" />\n        </div>\n      </div>\n\n      {/* Main Editorial Hero Content */}\n      <div className=\"relative z-10 max-w-7xl w-full mx-auto my-auto py-12 lg:py-16\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end\">\n          <div className=\"lg:col-span-8 space-y-6\">\n            {/* Small Descriptor */}\n            <div className=\"inline-block\">\n              <span className=\"font-mono text-xs sm:text-sm font-semibold tracking-[0.25em] text-neutral-400 uppercase border-l-2 border-white pl-3\">\n                {PERSONAL_INFO.role}\n              </span>\n            </div>\n\n            {/* Oversized Name Header */}\n            <h1 className=\"font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl lg:text-8xl tracking-tight text-white uppercase leading-[0.95] text-balance\">\n              HASSAN ABDULSATAR <br />\n              <span className=\"text-neutral-400\">OLAMIDE</span>\n            </h1>\n\n            {/* Primary Headline */}\n            <p className=\"font-heading font-medium text-2xl sm:text-3xl lg:text-4xl text-neutral-200 tracking-tight leading-snug pt-2\">\n              \"{PERSONAL_INFO.headline}\"\n            </p>\n\n            {/* Supporting Copy */}\n            <p className=\"font-sans text-base sm:text-lg text-neutral-400 max-w-2xl leading-relaxed font-normal\">\n              {PERSONAL_INFO.supportingCopy}\n            </p>\n\n            {/* CTAs */}\n            <div className=\"pt-6 flex flex-wrap items-center gap-4 sm:gap-6\">\n              <button\n                onClick={onExploreWork}\n                className=\"group relative inline-flex items-center justify-center gap-3 px-8 py-4 bg-white text-black font-mono text-xs font-bold tracking-widest uppercase transition-all duration-300 hover:bg-neutral-200 active:scale-95 shadow-lg\"\n              >\n                <span>VIEW SELECTED WORK</span>\n                <ArrowDown className=\"w-4 h-4 transition-transform duration-300 group-hover:translate-y-1\" />\n              </button>\n\n              <button\n                onClick={onConnect}\n                className=\"group inline-flex items-center justify-center gap-2 px-8 py-4 bg-transparent border border-neutral-700 text-white font-mono text-xs font-bold tracking-widest uppercase transition-all duration-300 hover:border-white hover:bg-white/5 active:scale-95\"\n              >\n                <span>LET\'S CONNECT</span>\n                <ArrowUpRight className=\"w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Right Column Stats / Key Focus Badge */}\n          <div className=\"lg:col-span-4 lg:pl-6 border-t lg:border-t-0 lg:border-l border-neutral-800 pt-8 lg:pt-0 space-y-6\">\n            <div className=\"bg-[#121212] border border-neutral-800 p-6 space-y-4\">\n              <div className=\"flex items-center justify-between border-b border-neutral-800 pb-3\">\n                <span className=\"font-mono text-[10px] text-neutral-500 uppercase tracking-widest\">\n                  CURRENT VENTURE FOCUS\n                </span>\n                <Sparkles className=\"w-3.5 h-3.5 text-neutral-400\" />\n              </div>\n\n              <div>\n                <h3 className=\"font-heading font-bold text-xl text-white tracking-wider\">\n                  VEYRA\n                </h3>\n                <p className=\"font-mono text-xs text-neutral-400 mt-1\">\n                  Team formation platform for ambitious young builders.\n                </p>\n              </div>\n\n              <div className=\"pt-2 flex items-center justify-between text-xs font-mono text-neutral-500\">\n                <span>STAGE: ACTIVE BUILD</span>\n                <a\n                  href=\"https://vetra-waitlist-azure.vercel.app/\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"text-white hover:underline flex items-center gap-1 font-semibold\"\n                >\n                  LIVE SITE <ArrowUpRight className=\"w-3 h-3\" />\n                </a>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-4 text-left\">\n              <div className=\"border border-neutral-800 p-4 bg-[#0E0E0E]\">\n                <p className=\"font-mono text-[10px] text-neutral-500 uppercase tracking-widest\">\n                  LOCATION\n                </p>\n                <p className=\"font-heading font-bold text-sm text-white mt-1\">\n                  NIGERIA \302\267 GLOBAL\n                </p>\n              </div>\n              <div className=\"border border-neutral-800 p-4 bg-[#0E0E0E]\">\n                <p className=\"font-mono text-[10px] text-neutral-500 uppercase tracking-widest\">\n                  SPECTRUM\n                </p>\n                <p className=\"font-heading font-bold text-sm text-white mt-1\">\n                  IDEA TO PRODUCTION\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Footer Line / Scroll Prompt */}\n      <div className=\"relative z-10 max-w-7xl w-full mx-auto pt-8 border-t border-neutral-900 flex items-center justify-between text-neutral-500 font-mono text-[11px] tracking-widest uppercase\">\n        <span className=\"hidden sm:inline\">01 / CONCEPT TO IMPLEMENTATION</span>\n        <span className=\"text-neutral-400\">SERIOUS PRODUCTS \302\267 DEFENSIBLE CODE</span>\n        <button\n          onClick={onExploreWork}\n          className=\"hover:text-white transition-colors flex items-center gap-2\"\n        >\n          <span>SCROLL TO WORK</span>\n          <ArrowDown className=\"w-3.5 h-3.5 animate-bounce\" />\n        </button>\n      </div>\n    </section>\n  );\n};\n"
    }
